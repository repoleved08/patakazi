# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# Public site URL. Used for canonicals, sitemap, OG images and llms.txt.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project settings -> API. The URL and the anon/publishable key are safe to ship
# to the browser: they are constrained by the RLS policies in
# `supabase/migrations/0001_init.sql`.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# Service-role key. BYPASSES row level security, so it must stay on the server:
# it is what `server/utils/supabase.ts` uses for privileged reads and writes
# after the services have checked ownership. Never expose this to the client.
NUXT_SUPABASE_SERVICE_KEY=

# --- Auth -----------------------------------------------------------------
# Supabase dashboard -> Authentication -> URL Configuration. Both the site URL
# and `/confirm` must be listed, or the magic-link email and the OAuth redirect
# land on a page that cannot complete the sign-in.
# Providers offered on the sign-in page must also be enabled under
# Authentication -> Providers.

# --- Schema ---------------------------------------------------------------
# Apply with `pnpm db:push` (requires the Supabase CLI and a linked project),
# or paste supabase/migrations/*.sql into the SQL editor.
# `pnpm db:reset` is the local equivalent when running `supabase start`.

# --- nuxt-ai-ready --------------------------------------------------------
# Shared secret for the runtime index sync endpoint.
NUXT_AI_READY_SYNC_SECRET=
